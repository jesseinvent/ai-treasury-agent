# --- Solana ---
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Use a real RPC (Helius, Triton, QuickNode). The public endpoint rate-limits hard.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Printed by `npm run setup:vault`
NEXT_PUBLIC_MULTISIG_ADDRESS=
SPENDING_LIMIT_USDC=
SPENDING_LIMIT_SOL=

# --- Agent ---
# Generate with `npm run gen:agent-key`. Server-only. Never prefix with NEXT_PUBLIC_.
AGENT_SECRET_KEY=
ANTHROPIC_API_KEY=

# Pyth Hermes needs a key since Aug 2026 (docs.pyth.network). Leave empty to use Jupiter prices.
PYTH_API_KEY=

# Plain-English investment policy the agent follows (optional; a conservative default is built in)
# AGENT_MANDATE="Keep 60% USDC / 40% SOL, rebalance on 10pp drift."

# Decision maker: "claude" (needs ANTHROPIC_API_KEY) or "rules" (coded rebalancer, free).
# Default: claude if ANTHROPIC_API_KEY is set, otherwise rules.
# AGENT_MODE=rules

# Dry run is ON unless set to false: decisions + Jupiter quotes are logged, nothing is sent.
AGENT_DRY_RUN=true

# Rules mode settings
AGENT_TARGET=USDC:50,SOL:50
AGENT_DRIFT_PCT=10
AGENT_SOL_RESERVE=0.05
AGENT_MIN_TRADE_USD=2

# Guardrails enforced in code (the on-chain spending limit is the hard backstop)
AGENT_AUTO_TRADE_MAX_USD=25
AGENT_PROPOSAL_MAX_USD=1000
AGENT_MAX_SLIPPAGE_BPS=100
AGENT_MAX_ACTIONS_PER_TICK=2

# Protects /api/agent/tick in production (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Jupiter (lite-api is keyless; switch to https://api.jup.ag/swap/v1 with a key for higher limits)
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# --- setup:vault only ---
# HUMAN_KEYPAIR_PATH=~/.config/solana/id.json
SETUP_USDC_DAILY_LIMIT=50
SETUP_SOL_DAILY_LIMIT=0.25
